<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="almohtadinepaydesk.controllers.ChangePasswordController"
            styleClass="change-password-page">
    <top>
        <VBox spacing="6">
            <Label text="Changer mot de passe" styleClass="page-title" />
            <Label text="Modifier le mot de passe du compte connect&#233;." styleClass="page-subtitle" />
        </VBox>
    </top>

    <center>
        <VBox spacing="12" styleClass="change-password-card">
            <BorderPane.margin>
                <Insets top="18" right="0" bottom="0" left="0" />
            </BorderPane.margin>
            <padding>
                <Insets top="22" right="24" bottom="22" left="24" />
            </padding>

            <Label text="Ancien mot de passe" styleClass="field-label" />
            <PasswordField fx:id="oldPasswordField"
                           promptText="Ancien mot de passe"
                           maxWidth="420"
                           styleClass="text-input-field" />

            <Label text="Nouveau mot de passe" styleClass="field-label" />
            <PasswordField fx:id="newPasswordField"
                           promptText="Nouveau mot de passe"
                           maxWidth="420"
                           styleClass="text-input-field" />

            <Label text="Confirmer le mot de passe" styleClass="field-label" />
            <PasswordField fx:id="confirmPasswordField"
                           promptText="Confirmer le mot de passe"
                           maxWidth="420"
                           styleClass="text-input-field" />

            <Button text="Enregistrer"
                    onAction="#handleChangePassword"
                    maxWidth="180"
                    styleClass="primary-action-button" />
        </VBox>
    </center>
</BorderPane>
