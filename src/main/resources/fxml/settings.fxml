<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="almohtadinepaydesk.controllers.SettingsController"
            styleClass="settings-page">
    <top>
        <VBox spacing="6">
            <Label text="Param&#232;tres" styleClass="page-title" />
            <Label text="Configuration g&#233;n&#233;rale de l'application." styleClass="page-subtitle" />
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="form-scroll">
            <content>
                <VBox spacing="12" styleClass="settings-form-card">
                    <padding>
                        <Insets top="20" right="24" bottom="20" left="24" />
                    </padding>

                    <Label text="Informations principales" styleClass="form-title" />

                    <Label text="Nom de la garderie" styleClass="field-label" />
                    <TextField fx:id="garderieNameField"
                               promptText="Nom de la garderie"
                               maxWidth="520"
                               styleClass="text-input-field" />

                    <Label text="Ann&#233;e scolaire active" styleClass="field-label" />
                    <ComboBox fx:id="activeSchoolYearComboBox"
                              promptText="Ann&#233;e scolaire active"
                              maxWidth="520"
                              styleClass="combo-field" />

                    <Label text="Jour limite de paiement" styleClass="field-label" />
                    <TextField fx:id="paymentDeadlineDayField"
                               promptText="Exemple: 10"
                               maxWidth="220"
                               styleClass="text-input-field" />

                    <Label text="Dossier de sauvegarde" styleClass="field-label" />
                    <HBox spacing="10">
                        <TextField fx:id="backupFolderField"
                                   promptText="Dossier de sauvegarde"
                                   HBox.hgrow="ALWAYS"
                                   styleClass="text-input-field" />

                        <Button text="Choisir un dossier"
                                onAction="#handleChooseBackupFolder"
                                styleClass="secondary-action-button" />
                    </HBox>

                    <Label text="Chemin du logo" styleClass="field-label" />
                    <TextField fx:id="logoPathField"
                               promptText="Chemin du logo"
                               maxWidth="520"
                               styleClass="text-input-field" />

                    <Label text="Informations de contact" styleClass="field-label" />
                    <TextArea fx:id="contactInformationArea"
                              promptText="Adresse, t&#233;l&#233;phone, email..."
                              prefRowCount="4"
                              maxWidth="520"
                              wrapText="true"
                              styleClass="text-area-field" />

                    <Button text="Enregistrer les param&#232;tres"
                            onAction="#handleSaveSettings"
                            maxWidth="260"
                            styleClass="primary-action-button" />
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
