<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="almohtadinepaydesk.controllers.SchoolYearController"
            styleClass="school-years-page">
    <top>
        <VBox spacing="12">
            <Label text="Ann&#233;es scolaires" styleClass="page-title" />

            <HBox spacing="10" styleClass="filters-card">
                <padding>
                    <Insets top="12" right="14" bottom="12" left="14" />
                </padding>

                <TextField fx:id="schoolYearField"
                           promptText="Exemple: 2025/2026"
                           prefWidth="220"
                           styleClass="text-input-field" />

                <Button text="Ajouter une ann&#233;e"
                        onAction="#handleAddSchoolYear"
                        styleClass="primary-action-button" />
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="18">
            <padding>
                <Insets top="18" right="0" bottom="0" left="0" />
            </padding>

            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <TableView fx:id="schoolYearsTable" VBox.vgrow="ALWAYS" styleClass="school-years-table">
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="70" />
                        <TableColumn fx:id="nameColumn" text="Ann&#233;e scolaire" prefWidth="190" />
                        <TableColumn fx:id="activeColumn" text="Active" prefWidth="90" />
                    </columns>
                </TableView>

                <Button fx:id="setActiveButton"
                        text="D&#233;finir comme active"
                        onAction="#handleSetActiveSchoolYear"
                        maxWidth="Infinity"
                        styleClass="secondary-action-button" />
            </VBox>

            <VBox spacing="14" prefWidth="340" styleClass="month-card">
                <padding>
                    <Insets top="20" right="22" bottom="20" left="22" />
                </padding>

                <Label fx:id="selectedYearLabel"
                       text="Mois actifs"
                       styleClass="form-title" />

                <VBox fx:id="monthsBox" spacing="9" />

                <Button fx:id="saveMonthsButton"
                        text="Enregistrer les mois actifs"
                        onAction="#handleSaveActiveMonths"
                        maxWidth="Infinity"
                        styleClass="primary-action-button" />
            </VBox>
        </HBox>
    </center>
</BorderPane>
