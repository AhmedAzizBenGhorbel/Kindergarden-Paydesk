<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="almohtadinepaydesk.controllers.PaymentDetailController"
            styleClass="payment-detail-page">
    <padding>
        <Insets top="18" right="18" bottom="18" left="18" />
    </padding>

    <top>
        <VBox spacing="4">
            <Label text="D&#233;tail du paiement" styleClass="page-title" />
            <Label text="Consulter les montants et enregistrer les paiements re&#231;us." styleClass="page-subtitle" />
        </VBox>
    </top>

    <center>
        <HBox spacing="18">
            <padding>
                <Insets top="16" right="0" bottom="0" left="0" />
            </padding>

            <VBox spacing="14" HBox.hgrow="ALWAYS">
                <GridPane hgap="14" vgap="10" styleClass="detail-card">
                    <padding>
                        <Insets top="16" right="18" bottom="16" left="18" />
                    </padding>

                    <Label text="Enfant" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="detail-label" />
                    <Label fx:id="childNameLabel" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="detail-value" />

                    <Label text="Parent / tuteur" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="detail-label" />
                    <Label fx:id="parentNameLabel" GridPane.columnIndex="3" GridPane.rowIndex="0" styleClass="detail-value" />

                    <Label text="Ann&#233;e scolaire" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="detail-label" />
                    <Label fx:id="schoolYearLabel" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="detail-value" />

                    <Label text="Mois" GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="detail-label" />
                    <Label fx:id="monthLabel" GridPane.columnIndex="3" GridPane.rowIndex="1" styleClass="detail-value" />

                    <Label text="Frais mensuels" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="detail-label" />
                    <Label fx:id="baseFeeLabel" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="detail-value" />

                    <Label text="Frais suppl&#233;mentaires" GridPane.columnIndex="2" GridPane.rowIndex="2" styleClass="detail-label" />
                    <Label fx:id="extrasLabel" GridPane.columnIndex="3" GridPane.rowIndex="2" styleClass="detail-value" />

                    <Label text="Attendu" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="detail-label" />
                    <Label fx:id="expectedLabel" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="detail-value" />

                    <Label text="Pay&#233;" GridPane.columnIndex="2" GridPane.rowIndex="3" styleClass="detail-label" />
                    <Label fx:id="totalPaidLabel" GridPane.columnIndex="3" GridPane.rowIndex="3" styleClass="detail-value" />

                    <Label text="Restant" GridPane.columnIndex="0" GridPane.rowIndex="4" styleClass="detail-label" />
                    <Label fx:id="remainingLabel" GridPane.columnIndex="1" GridPane.rowIndex="4" styleClass="detail-value" />

                    <Label text="Avance" GridPane.columnIndex="2" GridPane.rowIndex="4" styleClass="detail-label" />
                    <Label fx:id="advanceLabel" GridPane.columnIndex="3" GridPane.rowIndex="4" styleClass="detail-value" />

                    <Label text="Statut" GridPane.columnIndex="0" GridPane.rowIndex="5" styleClass="detail-label" />
                    <Label fx:id="statusLabel" GridPane.columnIndex="1" GridPane.rowIndex="5" styleClass="status-value" />
                </GridPane>

                <VBox spacing="8" VBox.vgrow="ALWAYS">
                    <Label text="Historique des paiements" styleClass="form-title" />

                    <TableView fx:id="historyTable" prefHeight="285" VBox.vgrow="ALWAYS" styleClass="history-table">
                        <columns>
                            <TableColumn fx:id="paymentDateColumn" text="Date" prefWidth="100" />
                            <TableColumn fx:id="amountColumn" text="Montant" prefWidth="105" />
                            <TableColumn fx:id="methodColumn" text="M&#233;thode" prefWidth="110" />
                            <TableColumn fx:id="receiptColumn" text="Re&#231;u" prefWidth="130" />
                            <TableColumn fx:id="noteColumn" text="Note" prefWidth="220" />
                        </columns>
                    </TableView>
                </VBox>
            </VBox>

            <ScrollPane fitToWidth="true"
                        prefWidth="315"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        styleClass="form-scroll">
                <content>
                    <VBox spacing="10" styleClass="form-card">
                        <padding>
                            <Insets top="18" right="20" bottom="18" left="20" />
                        </padding>

                        <Label text="Ajouter un paiement" styleClass="form-title" />

                        <Label text="Montant pay&#233;" styleClass="field-label" />
                        <TextField fx:id="amountField"
                                   promptText="Exemple: 250.000"
                                   styleClass="text-input-field" />

                        <Label text="Date de paiement" styleClass="field-label" />
                        <DatePicker fx:id="paymentDatePicker"
                                    maxWidth="Infinity"
                                    promptText="Date de paiement"
                                    styleClass="date-field" />

                        <Label text="M&#233;thode" styleClass="field-label" />
                        <ComboBox fx:id="methodComboBox"
                                  maxWidth="Infinity"
                                  promptText="M&#233;thode"
                                  styleClass="combo-field" />

                        <Label text="Note" styleClass="field-label" />
                        <TextArea fx:id="noteArea"
                                  promptText="Note"
                                  prefRowCount="4"
                                  wrapText="true"
                                  styleClass="text-area-field" />

                        <Button text="Enregistrer le paiement"
                                maxWidth="Infinity"
                                onAction="#handleSavePayment"
                                styleClass="primary-action-button" />

                        <Button text="Fermer"
                                maxWidth="Infinity"
                                onAction="#handleClose"
                                styleClass="secondary-action-button" />
                    </VBox>
                </content>
            </ScrollPane>
        </HBox>
    </center>
</BorderPane>
